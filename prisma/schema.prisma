generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  created
  rx_received
  rx_review
  approved
  preparing
  shipped
  delivered
  cancelled
  refund_requested
  refunding
  refunded
}

enum TicketStatus {
  open
  answered
  closed
}

enum PaymentType {
  online
  cod
  card
}

enum SubstitutionPref {
  none
  similarAllowed
  askMe
}

enum ReplyFrom {
  user
  support
  pharmacy
}

enum PrescriptionStatus {
  received
  review
  needs_fix
  approved
}

enum SubstitutionStatus {
  pending
  accepted
  rejected
}

enum AuditActor {
  user
  pharmacy
  admin
}

enum AdminRole {
  superAdmin
  ops
  support
  finance
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]
  tickets   Ticket[]
  favorites Favorite[]
  ratings   Rating[]
  prescriptions Prescription[]
  notifications Notification[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  province      String
  city          String
  line1         String
  line2         String?
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Pharmacy {
  id             String     @id
  slug           String     @unique
  name           String
  rating         Float      @default(0)
  isOpen         Boolean    @default(true)
  deliveryEtaMin Int
  deliveryEtaMax Int
  tags           String[]
  addressShort   String
  coverStyle     String?
  city           String?
  createdAt      DateTime   @default(now())
  products       Product[]
  favorites      Favorite[]
  ratings        Rating[]
  orders         Order[]
  users          PharmacyUser[]
  prescriptions  Prescription[]
  substitutionProposals SubstitutionProposal[]
}

model Product {
  id          String    @id
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  subtitle    String?
  price       Int
  inStock     Boolean   @default(true)
  description String?
  category    String?
  createdAt   DateTime  @default(now())
  orderItems  OrderItem[]

  @@index([pharmacyId])
}

model Order {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId       String
  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id])
  status           OrderStatus
  subtotal         Int
  discount         Int
  deliveryFee      Int
  payable          Int
  paymentType      PaymentType
  substitutionPref SubstitutionPref
  notes            String?
  addressId        String?
  deliverySlotId   String?
  timeline         Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orderItems       OrderItem[]
  ratings          Rating[]
  tickets          Ticket[]
  prescriptions    Prescription[]
  substitutionProposals SubstitutionProposal[]

  @@index([userId])
  @@index([pharmacyId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Int
  qty       Int
  subtitle  String?
  substitutionProposals SubstitutionProposalItem[]
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  subject   String
  message   String
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())
  replies   TicketReply[]

  @@index([userId])
}

model TicketReply {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  from      ReplyFrom
  text      String
  createdAt DateTime  @default(now())
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId String
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([userId, pharmacyId])
  @@index([userId])
}

model Rating {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  pharmacyId String
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  score      Int
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([orderId, userId])
  @@index([userId])
  @@index([pharmacyId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         AdminRole
  createdAt    DateTime  @default(now())
}

model PharmacyUser {
  id          String    @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  passwordHash String?
  role        String
  createdAt   DateTime  @default(now())

  @@index([pharmacyId])
}

model Prescription {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id])
  pharmacyId String?
  pharmacy   Pharmacy?         @relation(fields: [pharmacyId], references: [id])
  fileUrl    String?
  fileType   String?
  status     PrescriptionStatus
  createdAt  DateTime          @default(now())

  @@index([orderId])
  @@index([pharmacyId])
}

model SubstitutionProposal {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacyId String
  pharmacy   Pharmacy            @relation(fields: [pharmacyId], references: [id])
  status     SubstitutionStatus  @default(pending)
  items      Json
  createdAt  DateTime            @default(now())
  respondedAt DateTime?
  proposalItems SubstitutionProposalItem[]

  @@index([orderId])
  @@index([pharmacyId])
}

model SubstitutionProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    SubstitutionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  originalName String
  proposedName String
  priceDelta   Int
  note         String?
}

model AuditLog {
  id         String     @id @default(cuid())
  actorType  AuditActor
  actorId    String
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  metaJson  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
